{
  "DetailedErrors": true,
  "ConnectionStrings": {
    "PrototypeManager": "Data Source=prototype-manager.db"
  },
  "Provisioning": {
    "Mode": "Azure",
    "AzureSubscriptionId": "<azure-subscription-id>",
    "Location": "westeurope",
    "CompiledTemplatePath": "../../infra/compiled/prototype-hosting.json"
  },
  "GitHub": {
    "ValidateWithApi": false,
    "PersonalAccessToken": "",
    "AutoConfigureDeployment": true,
    "WorkflowBranch": "main",
    "WorkflowFileName": "deploy-prototype.yml",
    "TriggerInitialDeployment": true,
    "PublishProfileSecretName": "AZURE_WEBAPP_PUBLISH_PROFILE"
  },
  "DevelopmentUser": {
    "Enabled": true,
    "Email": "prototype.owner@example.gov.uk",
    "DisplayName": "Prototype Owner",
    "Team": "DesignOps",
    "Directorate": "Digital",
    "Roles": [ "User", "Admin" ],
    "AssignedBusinessAreas": [
      "Schools Digital",
      "Customer Experience and Design",
      "Central Operations"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "PrototypeManager.Infrastructure": "Information"
    }
  }
}
