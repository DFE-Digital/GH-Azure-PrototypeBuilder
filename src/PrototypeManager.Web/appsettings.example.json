{
  "ConnectionStrings": {
    "PrototypeManager": "Server=(localdb)\\mssqllocaldb;Database=PrototypeManager;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Provisioning": {
    "Mode": "Azure",
    "AzureSubscriptionId": "<azure-subscription-id>",
    "Location": "westeurope",
    "CompiledTemplatePath": "infra/compiled/prototype-hosting.json"
  },
  "CostControl": {
    "AllowedRegions": [ "westeurope" ],
    "AllowedSkus": [ "F1" ],
    "AllowedRuntime": "NODE|24-lts",
    "MaximumExpiryDays": 365,
    "RequireOwner": true,
    "RequireDeputyOwner": false,
    "RequireNoRealUserData": true,
    "RequireNotProduction": true
  },
  "GitHub": {
    "ValidateWithApi": false,
    "PersonalAccessToken": "",
    "AutoConfigureDeployment": true,
    "WorkflowBranch": "main",
    "WorkflowFileName": "deploy-prototype.yml",
    "TriggerInitialDeployment": true,
    "PublishProfileSecretName": "AZURE_WEBAPP_PUBLISH_PROFILE"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/signin-oidc"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
