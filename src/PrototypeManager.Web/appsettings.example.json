{
  "ConnectionStrings": {
    "PrototypeManager": "Server=(localdb)\\mssqllocaldb;Database=PrototypeManager;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Provisioning": {
    "Mode": "Azure",
    "AzureSubscriptionId": "<azure-subscription-id>",
    "Location": "westeurope",
    "CompiledTemplatePath": "infra/compiled/prototype-hosting.json"
  },
  "CostControl": {
    "AllowedRegions": [ "westeurope" ],
    "AllowedSkus": [ "F1" ],
    "AllowedRuntime": "NODE|24-lts",
    "MaximumExpiryDays": 365,
    "RequireOwner": true,
    "RequireDeputyOwner": false,
    "RequireNoRealUserData": true,
    "RequireNotProduction": true
  },
  "GitHub": {
    "ValidateWithApi": true,
    "AppId": 0,
    "InstallationId": 0,
    "PrivateKey": "",
    "PrivateKeyPath": "",
    "PersonalAccessToken": "",
    "AutoConfigureDeployment": true,
    "WorkflowBranch": "main",
    "WorkflowFileName": "deploy-prototype.yml",
    "TriggerInitialDeployment": true,
    "PublishProfileSecretName": "AZURE_WEBAPP_PUBLISH_PROFILE",
    "DefaultCollaborators": [ "<github-username>" ],
    "DefaultCollaboratorPermission": "admin"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<entra-tenant-id>",
    "ClientId": "<entra-app-client-id>",
    "ClientSecret": "<entra-app-client-secret>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CompassApi": {
    "BaseUrl": "https://example.com",
    "ApiToken": "",
    "CatalogCacheSeconds": 300
  },
  "Notify": {
    "ApiKey": "",
    "PrototypeReadyTemplateId": "",
    "HelpEmail": "someone@example.com"
  }
}
