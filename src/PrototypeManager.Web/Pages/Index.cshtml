@page
@model IndexModel
@{
    ViewData["Title"] = Model.MyPrototypes.Any() ? "Dashboard" : "Prototype Manager";
    ViewData["ServiceNavigationInverse"] = true;
    var activeBusinessAreas = Model.BusinessAreas
        .Where(area => area.PrototypeCount > 0)
        .OrderByDescending(area => area.PrototypeCount)
        .ThenBy(area => area.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();
}

<div class="dfe-c-fe-shell dfe-c-fe-dashboard">
    @if (!Model.MyPrototypes.Any())
    {
        <div class="dfe-c-fe-start-page">
            <section class="dfe-c-fe-start-page__hero" aria-labelledby="dashboard-welcome-title">
                <div class="dfe-c-fe-start-page__hero-layout">
                    <div class="dfe-c-fe-start-page__hero-inner">
                        <h1 class="govuk-heading-xl dfe-c-fe-start-page__title" id="dashboard-welcome-title">
                            Set up and host prototypes on DfE infrastructure
                        </h1>
                        <p class="govuk-body-l dfe-c-fe-start-page__lead">
                            Signed in as <strong>@User.GetDisplayName()</strong>.
                            Create and run prototypes for trying and testing product ideas and use in research quickly and easily.
                        </p>
                        <div class="dfe-c-fe-start-page__cta-actions" role="group" aria-label="Get started">
                            <a class="govuk-button dfe-c-fe-start-page__cta-primary"
                               href="@Url.Page("/Prototypes/Create")">
                                Start a new prototype
                            </a>
                            <a class="govuk-link dfe-c-fe-start-page__cta-link"
                               href="@Url.Page("/Prototypes/New")">
                                Host an existing prototype
                            </a>
                        </div>
                    </div>
                    <div class="dfe-c-fe-start-page__hero-visual" aria-hidden="true">
                        <img class="dfe-c-fe-start-page__hero-image"
                             src="@Url.Content("~/images/prototype-manager-hero.png")"
                             alt=""
                             width="1024"
                             height="512"
                             decoding="async" />
                    </div>
                </div>
            </section>

            <section class="dfe-c-fe-start-page__body" aria-labelledby="why-use-heading">
                <h2 class="govuk-heading-l" id="why-use-heading">Why use Prototype Manager</h2>
                <ul class="dfe-c-fe-benefit-grid">
                    <li class="dfe-c-fe-benefit-card dfe-c-fe-benefit-card--cost">
                        <div class="dfe-c-fe-benefit-card__header">
                            <span class="dfe-c-fe-benefit-card__icon dfe-c-fe-benefit-card__icon--glyph" aria-hidden="true">£</span>
                            <h3 class="govuk-heading-s dfe-c-fe-benefit-card__title">Free</h3>
                        </div>
                        <p class="govuk-body dfe-c-fe-benefit-card__text">
                            Host prototypes for free at no cost to your team.
                        </p>
                    </li>
                    <li class="dfe-c-fe-benefit-card dfe-c-fe-benefit-card--azure">
                        <div class="dfe-c-fe-benefit-card__header">
                            <span class="dfe-c-fe-benefit-card__icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                                    <path fill="currentColor" d="M12 3.5 4.5 6.2v5.3c0 4.4 3.1 8.4 7.5 9.5 4.4-1.1 7.5-5.1 7.5-9.5V6.2L12 3.5Z" opacity=".16"/>
                                    <path stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                          d="M12 3.5 4.5 6.2v5.3c0 4.4 3.1 8.4 7.5 9.5 4.4-1.1 7.5-5.1 7.5-9.5V6.2L12 3.5Z"/>
                                    <path stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                          d="m9.4 12.1 1.8 1.8 3.5-3.9"/>
                                </svg>
                            </span>
                            <h3 class="govuk-heading-s dfe-c-fe-benefit-card__title">Managed</h3>
                        </div>
                        <p class="govuk-body dfe-c-fe-benefit-card__text">
                            All prototypes hosted on DfE infrastructure securely.
                        </p>
                    </li>
                    <li class="dfe-c-fe-benefit-card dfe-c-fe-benefit-card--speed">
                        <div class="dfe-c-fe-benefit-card__header">
                            <span class="dfe-c-fe-benefit-card__icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                                    <path fill="currentColor" d="M13 3 5.2 13.8h5.1L9.8 21 18.8 10.2h-5.2L13 3Z" opacity=".18"/>
                                    <path stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                          d="M13 3 5.2 13.8h5.1L9.8 21 18.8 10.2h-5.2L13 3Z"/>
                                </svg>
                            </span>
                            <h3 class="govuk-heading-s dfe-c-fe-benefit-card__title">Fast setup</h3>
                        </div>
                        <p class="govuk-body dfe-c-fe-benefit-card__text">
                            Get a prototype up and running in under 5 minutes.
                        </p>
                    </li>
                    <li class="dfe-c-fe-benefit-card dfe-c-fe-benefit-card--research">
                        <div class="dfe-c-fe-benefit-card__header">
                            <span class="dfe-c-fe-benefit-card__icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                                    <circle cx="12" cy="12" r="8.2" fill="currentColor" opacity=".14"/>
                                    <path stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                          d="M7 12h10M13.5 8.5 17 12l-3.5 3.5"/>
                                </svg>
                            </span>
                            <h3 class="govuk-heading-s dfe-c-fe-benefit-card__title">Use existing prototypes</h3>
                        </div>
                        <p class="govuk-body dfe-c-fe-benefit-card__text">
                            If you’ve been using Heroku, deploy your existing prototype using the manager easily.
                        </p>
                    </li>
                    <li class="dfe-c-fe-benefit-card dfe-c-fe-benefit-card--team">
                        <div class="dfe-c-fe-benefit-card__header">
                            <span class="dfe-c-fe-benefit-card__icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                                    <circle cx="12" cy="12" r="8.2" fill="currentColor" opacity=".14"/>
                                    <circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.8"/>
                                    <circle cx="12" cy="12" r="3.1" stroke="currentColor" stroke-width="1.8"/>
                                    <path stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                          d="M12 3.8v2.4M12 17.8v2.4M3.8 12h2.4M17.8 12h2.4"/>
                                </svg>
                            </span>
                            <h3 class="govuk-heading-s dfe-c-fe-benefit-card__title">Supported by DesignOps</h3>
                        </div>
                        <p class="govuk-body dfe-c-fe-benefit-card__text">
                            Built, maintained and fully supported by DesignOps.
                        </p>
                    </li>
                    <li class="dfe-c-fe-benefit-card dfe-c-fe-benefit-card--github">
                        <div class="dfe-c-fe-benefit-card__header">
                            <span class="dfe-c-fe-benefit-card__icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 98 96" fill="currentColor" focusable="false">
                                    <path fill-rule="evenodd" clip-rule="evenodd"
                                          d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.336-3.015.336-3.015 4.934.346 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"/>
                                </svg>
                            </span>
                            <h3 class="govuk-heading-s dfe-c-fe-benefit-card__title">GitHub</h3>
                        </div>
                        <p class="govuk-body dfe-c-fe-benefit-card__text">
                            Clone your repo and work locally, push up changes and your changes will deploy automatically.
                        </p>
                    </li>
                </ul>
            </section>
        </div>
    }
    else
    {
        <header class="dfe-c-fe-page-header dfe-c-fe-dashboard__header">
            <div class="dfe-c-fe-page-header__intro">
                <h1 class="dfe-c-fe-title">Dashboard</h1>
                <p class="dfe-c-fe-text">
                    Signed in as <strong>@User.GetDisplayName()</strong>.
                    Prototypes you own, manage, or can access through your business areas.
                </p>
            </div>
            <div class="dfe-c-fe-page-header__actions">
                <a class="govuk-button" href="@Url.Page("/Prototypes/Create")">Create a prototype</a>
                <a class="govuk-button govuk-button--secondary" href="@Url.Page("/Prototypes/New")">Host an existing prototype</a>
            </div>
        </header>

        <ul class="dfe-c-fe-summary-strip" aria-label="Your prototype summary">
            <li class="dfe-c-fe-summary-strip__item">
                <span class="dfe-c-fe-summary-strip__value">@Model.MyPrototypes.Count</span>
                <span class="dfe-c-fe-summary-strip__label">visible</span>
            </li>
            <li class="dfe-c-fe-summary-strip__item">
                <span class="dfe-c-fe-summary-strip__value">@Model.LiveCount</span>
                <span class="dfe-c-fe-summary-strip__label">live</span>
            </li>
            <li class="dfe-c-fe-summary-strip__item @(Model.ActiveJobCount > 0 ? "dfe-c-fe-summary-strip__item--info" : null)">
                <span class="dfe-c-fe-summary-strip__value">@Model.ActiveJobCount</span>
                <span class="dfe-c-fe-summary-strip__label">in progress</span>
            </li>
            <li class="dfe-c-fe-summary-strip__item @(Model.FailedCount > 0 ? "dfe-c-fe-summary-strip__item--danger" : null)">
                <span class="dfe-c-fe-summary-strip__value">@Model.FailedCount</span>
                <span class="dfe-c-fe-summary-strip__label">failed</span>
            </li>
        </ul>

        @if (Model.HasAttentionItems)
        {
            <section class="dfe-c-fe-attention-banner" aria-labelledby="attention-heading">
                <div class="dfe-c-fe-attention-banner__intro">
                    <h2 class="dfe-c-fe-heading" id="attention-heading">Needs attention</h2>
                    <p class="dfe-c-fe-text">
                        @Model.FailedDeployments.Count failed deployment@(Model.FailedDeployments.Count == 1 ? string.Empty : "s").
                    </p>
                </div>
                <ul class="dfe-c-fe-attention-banner__list">
                    @foreach (var prototype in Model.FailedDeployments.Take(5))
                    {
                        <li>
                            <a class="govuk-link"
                               asp-page="/Prototypes/Details"
                               asp-route-id="@prototype.Id">
                                @prototype.Name
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }

        <div class="dfe-c-fe-dashboard-layout">
            <div class="dfe-c-fe-dashboard-layout__main">
                <section class="dfe-c-fe-panel dfe-c-fe-panel--flush" aria-labelledby="recent-prototypes-heading">
                    <div class="dfe-c-fe-panel__header dfe-c-fe-panel__header--split dfe-c-fe-panel__header--padded">
                        <div>
                            <h2 class="dfe-c-fe-heading" id="recent-prototypes-heading">Your prototypes</h2>
                            <p class="dfe-c-fe-text">
                                @if (Model.MyPrototypes.Count > Model.RecentPrototypes.Count)
                                {
                                    <span>Showing your @Model.RecentPrototypes.Count most recent.</span>
                                }
                                else
                                {
                                    <span>Recently updated prototypes you can access.</span>
                                }
                            </p>
                        </div>
                        <a class="dfe-c-fe-link" href="@Url.Page("/Prototypes/List")">View all</a>
                    </div>

                    <ul class="dfe-c-fe-app-list govuk-!-margin-bottom-0">
                        @foreach (var prototype in Model.RecentPrototypes)
                        {
                            var repositoryName = PrototypeGitHubRepositoryUrls.TryGetRepositoryName(prototype.GitHubRepositoryUrl);
                            var repositoryUrl = PrototypeGitHubRepositoryUrls.Normalize(prototype.GitHubRepositoryUrl);
                            <li class="dfe-c-fe-app-row dfe-c-fe-app-row--dashboard">
                                <div class="dfe-c-fe-app-row__main">
                                    <span class="dfe-c-fe-app-row__icon" aria-hidden="true">@prototype.Name[..1].ToUpperInvariant()</span>
                                    <span class="dfe-c-fe-app-row__content">
                                        <a class="dfe-c-fe-app-row__name govuk-link"
                                           asp-page="/Prototypes/Details"
                                           asp-route-id="@prototype.Id">
                                            @prototype.Name
                                        </a>
                                        <span class="dfe-c-fe-app-row__meta">
                                            @(prototype.BusinessArea?.Name ?? "No business area")
                                            @if (!string.IsNullOrWhiteSpace(repositoryName) && !string.IsNullOrWhiteSpace(repositoryUrl))
                                            {
                                                <span class="dfe-c-fe-app-row__meta-sep" aria-hidden="true"> · </span>
                                                <a class="govuk-link" href="@repositoryUrl" target="_blank" rel="noopener noreferrer">@repositoryName</a>
                                            }
                                        </span>
                                    </span>
                                </div>
                                <div class="dfe-c-fe-app-row__tools">
                                    <span class="@IndexModel.GetStatusBadgeClass(prototype.Status)">@IndexModel.GetStatusLabel(prototype.Status)</span>
                                    @if (!string.IsNullOrWhiteSpace(prototype.PrototypeUrl))
                                    {
                                        <a class="govuk-button dfe-c-fe-app-row__open"
                                           asp-page="/Prototypes/Open"
                                           asp-route-id="@prototype.Id">
                                            Open<span class="govuk-visually-hidden"> @prototype.Name</span>
                                        </a>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            </div>

            <aside class="dfe-c-fe-dashboard-layout__aside">
                <section class="dfe-c-fe-panel" aria-labelledby="business-areas-heading">
                    <div class="dfe-c-fe-panel__header">
                        <h2 class="dfe-c-fe-heading" id="business-areas-heading">Business areas</h2>
                        <p class="dfe-c-fe-text">
                            @if (activeBusinessAreas.Any())
                            {
                                <span>Areas with prototypes you can access.</span>
                            }
                            else if (User.IsAdmin())
                            {
                                <span>No business areas have prototypes yet.</span>
                            }
                            else
                            {
                                <span>Business areas assigned to you.</span>
                            }
                        </p>
                    </div>

                    @if (activeBusinessAreas.Any())
                    {
                        <ul class="dfe-c-fe-area-list govuk-!-margin-bottom-0">
                            @foreach (var businessArea in activeBusinessAreas.Take(8))
                            {
                                <li class="dfe-c-fe-area-list__item">
                                    <a class="dfe-c-fe-area-list__link"
                                       asp-page="/Prototypes/List"
                                       asp-route-scope="team"
                                       asp-route-team="@businessArea.Id">
                                        <span class="dfe-c-fe-area-list__name">@businessArea.Name</span>
                                        <span class="dfe-c-fe-badge dfe-c-fe-badge--muted">
                                            @businessArea.PrototypeCount
                                        </span>
                                    </a>
                                </li>
                            }
                        </ul>
                        @if (activeBusinessAreas.Count > 8)
                        {
                            <p class="dfe-c-fe-meta govuk-!-margin-top-3 govuk-!-margin-bottom-0">
                                <a class="govuk-link" href="@Url.Page("/Prototypes/List", new { scope = "all" })">
                                    View all prototypes
                                </a>
                            </p>
                        }
                    }
                    else
                    {
                        <ul class="dfe-c-fe-area-list dfe-c-fe-area-list--compact govuk-!-margin-bottom-0">
                            @foreach (var businessArea in Model.BusinessAreas.OrderBy(area => area.Name, StringComparer.OrdinalIgnoreCase).Take(6))
                            {
                                <li class="dfe-c-fe-area-list__item">
                                    <span class="dfe-c-fe-area-list__name">@businessArea.Name</span>
                                </li>
                            }
                        </ul>
                        @if (Model.BusinessAreas.Count > 6)
                        {
                            <p class="dfe-c-fe-meta govuk-!-margin-top-3 govuk-!-margin-bottom-0">
                                + @(Model.BusinessAreas.Count - 6) more
                            </p>
                        }
                    }
                </section>

                <p class="dfe-c-fe-dashboard__footer-help">
                    <a class="govuk-link" href="@Url.Page("/GettingStarted")">How Prototype Manager works</a>
                </p>
            </aside>
        </div>
    }
</div>
