@page
@model PrototypeManager.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin";
    ViewData[AdminNavigation.SectionViewDataKey] = AdminNavigation.DashboardSection;
}

<div class="dfe-c-fe-shell">
    <header class="dfe-c-fe-page-header">
        <div class="dfe-c-fe-page-header__intro">
            <h1 class="dfe-c-fe-title">@AdminNavigation.SectionTitle(AdminNavigation.DashboardSection)</h1>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0">
                Overview of prototypes, users, business areas, and deployment health.
                <a class="govuk-link" asp-page="/Admin/DependencyHealth">Check dependency health</a>
                for Azure hosting and GitHub access.
            </p>
        </div>
    </header>

    <div class="dfe-c-fe-dashboard__metrics govuk-!-margin-bottom-6">
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Business areas</h2>
            <p class="dfe-c-fe-metric__value">@Model.BusinessAreaCount</p>
        </section>
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Total prototypes</h2>
            <p class="dfe-c-fe-metric__value">@Model.TotalPrototypeCount</p>
            <p class="dfe-c-fe-metric__action govuk-!-margin-bottom-0">
                <a class="govuk-link" asp-page="/Admin/Prototypes">Manage prototypes</a>
            </p>
        </section>
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Users</h2>
            <p class="dfe-c-fe-metric__value">@Model.TotalUserCount</p>
            <p class="dfe-c-fe-metric__action govuk-!-margin-bottom-0">
                <a class="govuk-link" asp-page="/Admin/Users">Manage access</a>
            </p>
        </section>
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Exception requests</h2>
            <p class="dfe-c-fe-metric__value">
                @if (Model.OpenExceptionRequestCount > 0)
                {
                    <span class="dfe-c-fe-badge dfe-c-fe-badge--danger">@Model.OpenExceptionRequestCount</span>
                }
                else
                {
                    @Model.OpenExceptionRequestCount
                }
            </p>
            <p class="dfe-c-fe-metric__action govuk-!-margin-bottom-0">
                <a class="govuk-link" asp-page="/Admin/Exceptions">Review requests</a>
            </p>
        </section>
    </div>

    <h2 class="govuk-heading-m">Deployments</h2>
    <div class="dfe-c-fe-dashboard__metrics govuk-!-margin-bottom-6">
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Active</h2>
            <p class="dfe-c-fe-metric__value">
                <span class="dfe-c-fe-badge dfe-c-fe-badge--success">@Model.ActiveDeploymentCount</span>
            </p>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0 govuk-!-margin-top-2">
                Live or in progress, with a recent successful deployment.
            </p>
        </section>
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Stale</h2>
            <p class="dfe-c-fe-metric__value">
                <span class="dfe-c-fe-badge dfe-c-fe-badge--danger">@Model.StaleDeploymentCount</span>
            </p>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0 govuk-!-margin-top-2">
                Live, but no successful deployment for over 2 months.
            </p>
        </section>
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Failed</h2>
            <p class="dfe-c-fe-metric__value">
                <span class="dfe-c-fe-badge dfe-c-fe-badge--danger">@Model.FailedDeploymentCount</span>
            </p>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0 govuk-!-margin-top-2">
                Failed hosting status or latest job failed.
            </p>
        </section>
    </div>

    <h2 class="govuk-heading-m">Business areas</h2>
    @if (!Model.BusinessAreas.Any())
    {
        <p class="govuk-body">There are no business areas yet.</p>
    }
    else
    {
        <div class="dfe-c-fe-dashboard__metrics admin-business-area-cards">
        @foreach (var area in Model.BusinessAreas)
        {
            <section class="dfe-c-fe-panel dfe-c-fe-metric">
                <h3 class="dfe-c-fe-metric__label">Business area</h3>
                <p class="dfe-c-fe-metric__value">@area.Name</p>
                <dl class="admin-business-area-cards__stats govuk-!-margin-top-3 govuk-!-margin-bottom-0">
                    <div class="admin-business-area-cards__stat">
                        <dt>Prototypes</dt>
                        <dd>@area.PrototypeCount</dd>
                    </div>
                    <div class="admin-business-area-cards__stat">
                        <dt>Users</dt>
                        <dd>@area.UserCount</dd>
                    </div>
                </dl>
            </section>
        }
        </div>
    }
</div>
