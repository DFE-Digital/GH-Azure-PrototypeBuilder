@page
@model PrototypeManager.Web.Pages.Admin.ExceptionsModel
@{
    ViewData["Title"] = "Exception requests";
    ViewData[AdminNavigation.SectionViewDataKey] = AdminNavigation.ExceptionsSection;
}

<h1 class="govuk-heading-l">@AdminNavigation.SectionTitle(AdminNavigation.ExceptionsSection)</h1>
<p class="govuk-body">
    Higher-plan requests from prototype owners. DesignOps is emailed when a request is raised.
    Approve by setting a temporary plan on the prototype.
</p>

@if (!Model.ExceptionRequests.Any())
{
    <p class="govuk-body">There are no exception requests yet.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Prototype</th>
                <th scope="col" class="govuk-table__header">Requested by</th>
                <th scope="col" class="govuk-table__header">Requested plan</th>
                <th scope="col" class="govuk-table__header">Status</th>
                <th scope="col" class="govuk-table__header">Requested</th>
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
        @foreach (var request in Model.ExceptionRequests)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">
                    @(request.Prototype?.Name ?? request.PrototypeId.ToString())
                </td>
                <td class="govuk-table__cell">@request.RequestedBy</td>
                <td class="govuk-table__cell">@request.RequestedSku</td>
                <td class="govuk-table__cell">@request.Status</td>
                <td class="govuk-table__cell">@request.CreatedAt.ToString("dd MMM yyyy")</td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" asp-page="/Admin/PrototypeManage" asp-route-id="@request.PrototypeId">
                        Manage prototype
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
