@page
@model PrototypeManager.Web.Pages.Admin.GitHubHealthModel
@using PrototypeManager.Application
@{
    ViewData["Title"] = "GitHub health";
    ViewData[AdminNavigation.SectionViewDataKey] = AdminNavigation.GitHubHealthSection;
    var report = Model.Report;

    string StatusBadgeClass(GitHubHealthStatus status) => status switch
    {
        GitHubHealthStatus.Healthy => "dfe-c-fe-badge dfe-c-fe-badge--success",
        GitHubHealthStatus.Attention => "dfe-c-fe-badge dfe-c-fe-badge--warning",
        _ => "dfe-c-fe-badge dfe-c-fe-badge--danger"
    };

    string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}

<div class="dfe-c-fe-shell">
    <header class="dfe-c-fe-page-header">
        <div class="dfe-c-fe-page-header__intro">
            <h1 class="dfe-c-fe-title">GitHub health</h1>
            <p class="dfe-c-fe-text">
                Live check of the GitHub App or token this environment uses, the permissions it has, and the organisations Prototype Manager is allowed to use.
                The usual organisation is <strong>dfe-digital</strong>.
            </p>
            <p class="govuk-body govuk-!-margin-bottom-0">
                Checked @report.CheckedAt.ToString("dd MMM yyyy HH:mm") UTC.
                <a class="govuk-link" href="@Url.Page("/Admin/GitHubHealth")">Check again</a>.
            </p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <govuk-notification-banner>
            <govuk-notification-banner-title>Update</govuk-notification-banner-title>
            <p class="govuk-notification-banner__heading">@Model.StatusMessage</p>
        </govuk-notification-banner>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body" asp-validation-summary="All"></div>
            </div>
        </div>
    }

    <div class="dfe-c-fe-dashboard__metrics govuk-!-margin-bottom-6">
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Status</h2>
            <p class="dfe-c-fe-metric__value">
                <span class="@StatusBadgeClass(report.Status)">@report.StatusLabel</span>
            </p>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0 govuk-!-margin-top-2">@report.Summary</p>
        </section>
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Authentication</h2>
            <p class="dfe-c-fe-metric__value">@report.AuthenticationMode</p>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0 govuk-!-margin-top-2">
                @(report.UsesGitHubApp ? Show(report.AppName) : Show(report.AuthenticatedLogin))
            </p>
        </section>
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Permissions</h2>
            <p class="dfe-c-fe-metric__value">
                @(report.PermissionsChecked ? $"{report.SatisfiedPermissionCount} of {report.Permissions.Count}" : "—")
            </p>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0 govuk-!-margin-top-2">
                Required GitHub App permissions that are granted.
            </p>
        </section>
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Organisations</h2>
            <p class="dfe-c-fe-metric__value">
                @(report.Organisations.Any(organisation => organisation.WasChecked)
                    ? $"{report.AccessibleOrganisationCount} of {report.Organisations.Count}"
                    : report.Organisations.Count.ToString())
            </p>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0 govuk-!-margin-top-2">
                Allowed organisations this credential can access.
            </p>
        </section>
    </div>

    @if (report.Issues.Count > 0)
    {
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                @(report.Issues.Count == 1 ? "1 check needs attention." : $"{report.Issues.Count} checks need attention.")
            </strong>
        </div>
        <ul class="govuk-list govuk-list--bullet">
            @foreach (var issue in report.Issues)
            {
                <li>@issue</li>
            }
        </ul>
    }

    <h2 class="govuk-heading-m">Authentication</h2>
    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Mode</dt>
            <dd class="govuk-summary-list__value">@report.AuthenticationMode</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">API</dt>
            <dd class="govuk-summary-list__value">@report.ApiBaseUrl</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Repository checks</dt>
            <dd class="govuk-summary-list__value">@(report.ValidateWithApi ? "GitHub API validation is on" : "Format-only validation is on")</dd>
        </div>
        @if (report.AppId > 0)
        {
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">App ID</dt>
                <dd class="govuk-summary-list__value">@report.AppId</dd>
            </div>
        }
        @if (report.InstallationId > 0)
        {
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Installation ID</dt>
                <dd class="govuk-summary-list__value">@report.InstallationId</dd>
            </div>
        }
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Private key</dt>
            <dd class="govuk-summary-list__value">@(report.PrivateKeyConfigured ? "Configured" : "Not configured")</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Personal access token</dt>
            <dd class="govuk-summary-list__value">
                @if (report.PersonalAccessTokenConfigured && report.UsesGitHubApp)
                {
                    @:Configured, unused while the GitHub App is set
                }
                else if (report.PersonalAccessTokenConfigured)
                {
                    @:Configured
                }
                else
                {
                    @:Not configured
                }
            </dd>
        </div>
        @if (!string.IsNullOrWhiteSpace(report.AppName))
        {
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">GitHub App</dt>
                <dd class="govuk-summary-list__value">
                    @if (!string.IsNullOrWhiteSpace(report.AppUrl))
                    {
                        <a class="govuk-link" href="@report.AppUrl" target="_blank" rel="noopener noreferrer">
                            @report.AppName<span class="govuk-visually-hidden"> (opens in a new tab)</span>
                        </a>
                    }
                    else
                    {
                        @report.AppName
                    }
                </dd>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(report.AuthenticatedLogin))
        {
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Token account</dt>
                <dd class="govuk-summary-list__value">@report.AuthenticatedLogin</dd>
            </div>
        }
    </dl>

    @if (report.Installation is not null)
    {
        <h2 class="govuk-heading-m">Installation</h2>
        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Account</dt>
                <dd class="govuk-summary-list__value">
                    @if (!string.IsNullOrWhiteSpace(report.Installation.AccountUrl))
                    {
                        <a class="govuk-link" href="@report.Installation.AccountUrl" target="_blank" rel="noopener noreferrer">
                            @Show(report.Installation.AccountLogin)<span class="govuk-visually-hidden"> (opens in a new tab)</span>
                        </a>
                    }
                    else
                    {
                        @Show(report.Installation.AccountLogin)
                    }
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Account type</dt>
                <dd class="govuk-summary-list__value">@report.Installation.AccountType</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Repository access</dt>
                <dd class="govuk-summary-list__value">@report.Installation.RepositorySelectionLabel</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Suspended</dt>
                <dd class="govuk-summary-list__value">@(report.Installation.IsSuspended ? "Yes" : "No")</dd>
            </div>
            @if (report.AccessibleRepositoryCount is not null)
            {
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Accessible repositories</dt>
                    <dd class="govuk-summary-list__value">@report.AccessibleRepositoryCount</dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(report.Installation.SettingsUrl))
            {
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Installation settings</dt>
                    <dd class="govuk-summary-list__value">
                        <a class="govuk-link" href="@report.Installation.SettingsUrl" target="_blank" rel="noopener noreferrer">
                            Manage this installation on GitHub<span class="govuk-visually-hidden"> (opens in a new tab)</span>
                        </a>
                    </dd>
                </div>
            }
        </dl>
        @if (string.Equals(report.Installation.RepositorySelectionLabel, "Selected repositories", StringComparison.Ordinal))
        {
            <p class="govuk-body">
                This installation can only see selected repositories. Repositories it creates are included automatically. Add any other repository to the installation before hosting it.
            </p>
        }
    }

    @if (report.PermissionsChecked)
    {
        <h2 class="govuk-heading-m">Permissions</h2>
        <p class="govuk-body">
            These are the repository permissions Prototype Manager needs on the installation.
            After changing them on the GitHub App, an organisation owner must accept the update before new tokens include them.
        </p>
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Permission</th>
                    <th scope="col" class="govuk-table__header">Required</th>
                    <th scope="col" class="govuk-table__header">Granted</th>
                    <th scope="col" class="govuk-table__header">Status</th>
                    <th scope="col" class="govuk-table__header">Used for</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
            @foreach (var permission in report.Permissions)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@permission.Label</td>
                    <td class="govuk-table__cell">@permission.RequiredLabel</td>
                    <td class="govuk-table__cell">@permission.GrantedLabel</td>
                    <td class="govuk-table__cell">
                        @if (permission.IsSatisfied)
                        {
                            <span class="dfe-c-fe-badge dfe-c-fe-badge--success">Met</span>
                        }
                        else
                        {
                            <span class="dfe-c-fe-badge dfe-c-fe-badge--danger">Missing</span>
                        }
                    </td>
                    <td class="govuk-table__cell">@permission.Purpose</td>
                </tr>
            }
            </tbody>
        </table>
        @if (report.AdditionalPermissions.Count > 0)
        {
            <p class="govuk-body">
                Also granted:
                @string.Join(", ", report.AdditionalPermissions.Select(permission => $"{permission.Label} ({permission.LevelLabel.ToLowerInvariant()})")).
            </p>
        }
    }
    else if (report.TokenScopes.Count > 0)
    {
        <h2 class="govuk-heading-m">Token scopes</h2>
        <ul class="govuk-list govuk-list--bullet">
            @foreach (var scope in report.TokenScopes)
            {
                <li><code>@scope</code></li>
            }
        </ul>
    }

    @if (report.RateLimit is not null)
    {
        <h2 class="govuk-heading-m">API rate limit</h2>
        <p class="govuk-body">
            @report.RateLimit.Remaining of @report.RateLimit.Limit core requests remaining.
            Resets @report.RateLimit.ResetsAt.ToString("dd MMM yyyy HH:mm") UTC.
        </p>
    }

    <h2 class="govuk-heading-m" id="allowed-organisations">Allowed GitHub organisations</h2>
    <p class="govuk-body">
        Prototype Manager only creates and hosts repositories in this list.
        The GitHub App must be installed on each one. The usual organisation is <strong>dfe-digital</strong>.
        Use the installation settings link above to manage that installation on GitHub.
        At least one organisation must stay in the list.
    </p>

    <form method="post" asp-page-handler="Add" class="prototype-action-form">
        <div class="govuk-form-group @(ViewData.ModelState[nameof(Model.OrganisationName)]?.Errors.Count > 0 ? "govuk-form-group--error" : null)">
            <label class="govuk-label" asp-for="OrganisationName"></label>
            <div id="organisation-name-hint" class="govuk-hint">
                Organisation name, account name, or a github.com URL. For example, dfe-digital or https://github.com/dfe-digital.
            </div>
            <span class="govuk-error-message" asp-validation-for="OrganisationName"></span>
            <input class="govuk-input govuk-input--width-20" asp-for="OrganisationName" aria-describedby="organisation-name-hint" autocomplete="off" />
        </div>
        <govuk-button>Add organisation</govuk-button>
    </form>

    @if (!report.Organisations.Any())
    {
        <p class="govuk-body">No GitHub organisations are allowed yet.</p>
    }
    else
    {
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Organisation</th>
                    <th scope="col" class="govuk-table__header">Access</th>
                    <th scope="col" class="govuk-table__header">Added</th>
                    <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
            @foreach (var organisation in report.Organisations)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">
                        @if (!string.IsNullOrWhiteSpace(organisation.HtmlUrl))
                        {
                            <a class="govuk-link" href="@organisation.HtmlUrl" target="_blank" rel="noopener noreferrer">
                                @organisation.Name<span class="govuk-visually-hidden"> (opens in a new tab)</span>
                            </a>
                        }
                        else
                        {
                            @organisation.Name
                        }
                        @if (!string.IsNullOrWhiteSpace(organisation.CanonicalLogin) &&
                             !string.Equals(organisation.CanonicalLogin, organisation.Name, StringComparison.Ordinal))
                        {
                            <div class="govuk-hint govuk-!-margin-bottom-0">GitHub login: @organisation.CanonicalLogin</div>
                        }
                        @if (organisation.MatchesInstallation)
                        {
                            <div class="govuk-hint govuk-!-margin-bottom-0">Matches the GitHub App installation</div>
                        }
                    </td>
                    <td class="govuk-table__cell">
                        @if (!organisation.WasChecked)
                        {
                            <span class="dfe-c-fe-badge dfe-c-fe-badge--muted">Not checked</span>
                        }
                        else if (organisation.CanAccess)
                        {
                            <span class="dfe-c-fe-badge dfe-c-fe-badge--success">Accessible</span>
                        }
                        else
                        {
                            <span class="dfe-c-fe-badge dfe-c-fe-badge--danger">No access</span>
                            @if (!string.IsNullOrWhiteSpace(organisation.AccessError))
                            {
                                <div class="govuk-hint govuk-!-margin-bottom-0">@organisation.AccessError</div>
                            }
                        }
                    </td>
                    <td class="govuk-table__cell">
                        @organisation.CreatedAt.ToString("dd MMM yyyy")
                        <div class="govuk-hint govuk-!-margin-bottom-0">@organisation.CreatedBy</div>
                    </td>
                    <td class="govuk-table__cell">
                        @if (report.Organisations.Count > 1)
                        {
                            <form method="post" asp-page-handler="Remove" asp-route-id="@organisation.Id">
                                <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">
                                    Remove
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="govuk-hint govuk-!-margin-bottom-0">Only allowed organisation</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }

    <h2 class="govuk-heading-m">How Prototype Manager uses GitHub</h2>
    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Default collaborators</dt>
            <dd class="govuk-summary-list__value">
                @(report.DefaultCollaborators.Count == 0
                    ? "None"
                    : string.Join(", ", report.DefaultCollaborators))
            </dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Collaborator permission</dt>
            <dd class="govuk-summary-list__value">@Show(report.DefaultCollaboratorPermission)</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Deployment workflow</dt>
            <dd class="govuk-summary-list__value">
                @(report.AutoConfigureDeployment
                    ? $"Configured automatically on {report.WorkflowBranch}"
                    : "Not configured automatically")
            </dd>
        </div>
    </dl>
    <p class="govuk-body">
        Repository cleanup stays on <a class="govuk-link" asp-page="/Admin/GitHubCleanup">GitHub cleanup</a>.
        This page does not show private keys or tokens.
    </p>
</div>
