@page
@model PrototypeManager.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Business area access";
    ViewData[AdminNavigation.SectionViewDataKey] = AdminNavigation.UsersSection;
}

<h1 class="govuk-heading-l">@AdminNavigation.SectionTitle(AdminNavigation.UsersSection)</h1>
<p class="govuk-body">
    Assign people to business areas so they can see prototypes in those areas.
    Use <a class="govuk-link" href="@Url.Page("/Admin/Admins")">Prototype Manager admins</a>
    to grant full admin access, or
    <a class="govuk-link" href="@Url.Page("/Admin/RemoveAccess")">remove access</a>
    when someone leaves DfE.
</p>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <govuk-notification-banner>
        <govuk-notification-banner-title>Update</govuk-notification-banner-title>
        <p class="govuk-notification-banner__heading">@Model.StatusMessage</p>
    </govuk-notification-banner>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body" asp-validation-summary="All"></div>
        </div>
    </div>
}

<form method="post" class="prototype-action-form">
    <div class="govuk-form-group">
        <label class="govuk-label" asp-for="Input.Email"></label>
        <span class="govuk-error-message" asp-validation-for="Input.Email"></span>
        <input class="govuk-input" asp-for="Input.Email" autocomplete="off" />
    </div>

    <div class="govuk-form-group">
        <label class="govuk-label" asp-for="Input.DisplayName"></label>
        <input class="govuk-input" asp-for="Input.DisplayName" autocomplete="off" />
    </div>

    <div class="govuk-form-group">
        <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                Business areas
            </legend>
            <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                @foreach (var businessArea in Model.BusinessAreas)
                {
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input"
                               id="business-area-@businessArea.Id"
                               name="Input.BusinessAreaIds"
                               type="checkbox"
                               value="@businessArea.Id"
                               @(Model.Input.BusinessAreaIds.Contains(businessArea.Id) ? "checked" : null) />
                        <label class="govuk-label govuk-checkboxes__label" for="business-area-@businessArea.Id">
                            @businessArea.Name
                        </label>
                    </div>
                }
            </div>
        </fieldset>
    </div>

    <govuk-button>Save business area access</govuk-button>
</form>

<h2 class="govuk-heading-m govuk-!-margin-top-8">People with access</h2>
@if (!Model.Users.Any())
{
    <p class="govuk-body">No user access records have been created yet.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Email</th>
                <th scope="col" class="govuk-table__header">Business areas</th>
                <th scope="col" class="govuk-table__header">Prototypes</th>
                <th scope="col" class="govuk-table__header">Admin</th>
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
        @foreach (var user in Model.Users)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">
                    @user.Email
                    @if (!string.IsNullOrWhiteSpace(user.DisplayName) &&
                         !string.Equals(user.DisplayName, user.Email, StringComparison.OrdinalIgnoreCase))
                    {
                        <br />
                        <span class="govuk-hint govuk-!-margin-bottom-0">@user.DisplayName</span>
                    }
                </td>
                <td class="govuk-table__cell">
                    @(user.BusinessAreaNames.Any() ? string.Join(", ", user.BusinessAreaNames) : "—")
                </td>
                <td class="govuk-table__cell">@user.PrototypeAccessCount</td>
                <td class="govuk-table__cell">@(user.IsAdmin ? "Yes" : "No")</td>
                <td class="govuk-table__cell">
                    <a class="govuk-link"
                       href="@Url.Page("/Admin/RemoveAccess", new { email = user.Email })">
                        Remove access
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
