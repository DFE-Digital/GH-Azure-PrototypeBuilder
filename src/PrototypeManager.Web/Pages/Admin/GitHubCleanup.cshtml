@page
@model PrototypeManager.Web.Pages.Admin.GitHubCleanupModel
@{
    ViewData["Title"] = "GitHub cleanup";
    ViewData[AdminNavigation.SectionViewDataKey] = AdminNavigation.GitHubCleanupSection;
}

<h1 class="govuk-heading-l">@AdminNavigation.SectionTitle(AdminNavigation.GitHubCleanupSection)</h1>
<p class="govuk-body">
    Prototype Manager never deletes GitHub repositories automatically.
    These repositories were created for prototypes that no longer have an active entry here — clean them up manually in GitHub, then mark them as done.
</p>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <govuk-notification-banner>
        <govuk-notification-banner-title>Update</govuk-notification-banner-title>
        <p class="govuk-notification-banner__heading">@Model.StatusMessage</p>
    </govuk-notification-banner>
}

@if (!Model.OrphanedRepositories.Any())
{
    <p class="govuk-body">There are no orphaned prototype repositories waiting for cleanup.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Repository</th>
                <th scope="col" class="govuk-table__header">Prototype name</th>
                <th scope="col" class="govuk-table__header">Created by</th>
                <th scope="col" class="govuk-table__header">Created</th>
                <th scope="col" class="govuk-table__header">Reason</th>
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
        @foreach (var repository in Model.OrphanedRepositories)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">
                    <a class="govuk-link"
                       href="@repository.RepositoryUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        @repository.Owner/@repository.RepositoryName
                    </a>
                </td>
                <td class="govuk-table__cell">@repository.PrototypeName</td>
                <td class="govuk-table__cell">@repository.CreatedBy</td>
                <td class="govuk-table__cell">@repository.CreatedAt.ToString("dd MMM yyyy")</td>
                <td class="govuk-table__cell">@repository.Reason</td>
                <td class="govuk-table__cell">
                    <form method="post" asp-page-handler="MarkCleared" asp-route-id="@repository.Id">
                        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">
                            Mark cleaned up
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
