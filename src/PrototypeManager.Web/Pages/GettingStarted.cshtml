@page
@model GettingStartedModel
@using PrototypeManager.Web.Pages.Guidance
@{
    ViewData["Title"] = "Overview";
    ViewData[GuidanceNavigation.SectionViewDataKey] = GuidanceNavigation.Overview;
}

@section SideNav {
    @await Html.PartialAsync("_GuidanceSideNav")
}

<div class="dfe-c-fe-shell">
    <header class="dfe-c-fe-page-header">
        <div class="dfe-c-fe-page-header__intro">
            <p class="dfe-c-fe-eyebrow">User guide</p>
            <h1 class="dfe-c-fe-title">Overview</h1>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0">
                Set up and host prototypes on DfE infrastructure — without needing access to the Azure portal.
            </p>
        </div>
    </header>

    <h2 class="govuk-heading-m">What this service does</h2>
    <p class="govuk-body">
        Prototype Manager sets up and runs password-protected hosting for your prototypes.
        You keep the code in GitHub. We handle Azure infrastructure, cost controls, and deployment setup.
    </p>
    <ul class="govuk-list govuk-list--bullet">
        <li>provisions approved, cost-controlled Azure hosting for each prototype</li>
        <li>can create a new GitHub repository with the GOV.UK Prototype Kit, or host a repo you already have</li>
        <li>checks existing repos for Prototype Kit support and GOV.UK Frontend version when you host</li>
        <li>connects GitHub Actions so pushes to <code>main</code> deploy automatically</li>
        <li>gives you a live URL and password to share for research and stakeholder review</li>
        <li>lets teams manage contacts, config vars, and hosting without the Azure portal</li>
    </ul>

    <h2 class="govuk-heading-m govuk-!-margin-top-6">Get a prototype live</h2>
    <ol class="govuk-list getting-started-steps">
        <li>
            <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Create or connect a repository</h3>
            <p class="govuk-body">
                Use <a class="govuk-link" href="@Url.Page("/Prototypes/Create")">Create a prototype</a> for a new kit repo,
                or <a class="govuk-link" href="@Url.Page("/Prototypes/New")">Host an existing prototype</a> if the code is already on GitHub.
                See <a class="govuk-link" href="@Url.Page("/Guidance/CreateOrHost")">Create or host</a> for details.
            </p>
        </li>
        <li>
            <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Wait for setup</h3>
            <p class="govuk-body">
                Prototype Manager queues GitHub and Azure work in the background.
                Watch progress on the setup page and retry a failed step if needed.
                See <a class="govuk-link" href="@Url.Page("/Guidance/SetupAndDeploy")">Setup and deploy</a>.
            </p>
        </li>
        <li>
            <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Confirm deployment</h3>
            <p class="govuk-body">
                When hosting is ready, Deploy configures GitHub Actions and can trigger the first deploy.
                Later pushes to <code>main</code> update the live site automatically.
            </p>
        </li>
        <li>
            <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Share and manage</h3>
            <p class="govuk-body">
                Use Overview for the URL and password, Access for contacts, and Settings for config vars and lifecycle actions.
                See <a class="govuk-link" href="@Url.Page("/Guidance/Manage")">Manage a prototype</a>.
            </p>
        </li>
    </ol>

    <div class="govuk-inset-text">
        <p class="govuk-body">
            See <a class="govuk-link" href="@Url.Page("/Features")">Features</a> for what’s available now and what’s coming later.
            You can also suggest a feature from that page.
        </p>
        <p class="govuk-body govuk-!-margin-bottom-0">
            For how the platform is built — Azure pooling, the GitHub App, and background jobs — see
            <a class="govuk-link" href="@Url.Page("/Guidance/Technical")">technical documentation</a>.
        </p>
    </div>

    <div class="govuk-button-group govuk-!-margin-top-6">
        <govuk-button-link href="@Url.Page("/Prototypes/Create")">Create a prototype</govuk-button-link>
        <govuk-button-link href="@Url.Page("/Prototypes/New")" class="govuk-button--secondary">Host an existing prototype</govuk-button-link>
    </div>
</div>
