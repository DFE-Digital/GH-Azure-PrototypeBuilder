@page
@model PrototypeManager.Web.Pages.Prototypes.CreateModel
@{
    ViewData["Title"] = "Create a new prototype";
    var repositoryUrlPreview = string.IsNullOrWhiteSpace(Model.Input.GitHubOrganisation)
        ? string.Empty
        : PrototypeGitHubRepositoryUrls.FormatRepositoryExample(Model.Input.GitHubOrganisation, Model.RepositoryNamePreview);
}

@section SideNav {
    @await Html.PartialAsync("_AddPrototypeSideNav")
}

<div class="dfe-c-fe-shell">
    <header class="dfe-c-fe-page-header">
        <div class="dfe-c-fe-page-header__intro">
            <h1 class="dfe-c-fe-title">Create a new prototype</h1>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0">Use this if you are starting a brand new prototype.</p>
        </div>
    </header>

    <section class="dfe-c-fe-panel dfe-c-fe-panel--muted">
        <div class="dfe-c-fe-panel__header">
            <h2 class="dfe-c-fe-heading">Already have a GitHub repository?</h2>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0">
                If your prototype code is already in GitHub, use
                <a class="govuk-link" href="@Url.Page("/Prototypes/New")">Host an existing prototype</a> instead.
            </p>
        </div>
    </section>

    <section class="dfe-c-fe-panel dfe-c-fe-panel--muted">
        <div class="dfe-c-fe-panel__header">
            <h2 class="dfe-c-fe-heading">Prototype limitations</h2>
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0">
                Prototype hosting is free, but limited: each app has around 1 hour of server processing time per day, which is used in small amounts each time someone loads a page or uses the prototype, so test locally where possible and use hosted prototypes mainly for user research and stakeholder conversations.
            </p>
        </div>
    </section>

    <div class="dfe-c-fe-panel">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body" asp-validation-summary="All"></div>
                </div>
            </div>
        }

        <form method="post" class="processing-trigger" id="create-prototype-form">
            @if (!string.IsNullOrWhiteSpace(Model.AuthenticatedGitHubLogin))
            {
                <div class="govuk-inset-text">
                    The configured GitHub token belongs to <strong>@Model.AuthenticatedGitHubLogin</strong>.
                    Personal repositories will be created in that account using <code>/user/repos</code>.
                </div>
            }

            @if (Model.AllowedGitHubOrganisations.Any())
            {
                @if (Model.UsesDfeDigitalOrganisation && !Model.ShowGitHubOrganisationPicker)
                {
                    <input type="hidden" asp-for="Input.GitHubOrganisation" />
                    <div class="govuk-form-group">
                        <p class="govuk-body govuk-!-margin-bottom-0">
                            Your repo will be created in the DfE-Digital Enterprise organisation.
                        </p>
                    </div>
                }
                else
                {
                    <div class="govuk-form-group">
                        <label class="govuk-label" asp-for="Input.GitHubOrganisation"></label>
                        <span class="govuk-hint">
                            @if (Model.UsesDfeDigitalOrganisation)
                            {
                                <text>Your repo will be created in the DfE-Digital Enterprise organisation by default. Only change this for personal testing.</text>
                            }
                            else
                            {
                                <text>Choose where the new repository should be created.</text>
                            }
                        </span>
                        <span class="govuk-error-message" asp-validation-for="Input.GitHubOrganisation"></span>
                        <select class="govuk-select create-form__select"
                                asp-for="Input.GitHubOrganisation"
                                id="Input_GitHubOrganisation"
                                asp-items="@(new SelectList(Model.AllowedGitHubOrganisations, nameof(GitHubOrganisation.Name), nameof(GitHubOrganisation.Name), Model.Input.GitHubOrganisation))">
                            @if (Model.AllowedGitHubOrganisations.Count > 1)
                            {
                                <option value="">Select a GitHub organisation</option>
                            }
                        </select>
                    </div>
                }
            }

            <div class="govuk-form-group">
                <label class="govuk-label" asp-for="Input.AppName"></label>
                <span class="govuk-hint">
                    Must start with a letter. Spaces become hyphens. Use lowercase letters, numbers and hyphens only — max @SlugGenerator.AppNameMaxLength characters.
                    For example, <code>ey-training</code> or <code>teacher vacancies</code>. Do not include "prototype" in the name.
                </span>
                <span class="govuk-error-message" asp-validation-for="Input.AppName"></span>
                <input class="govuk-input govuk-input--width-20"
                       asp-for="Input.AppName"
                       id="prototype-app-name"
                       maxlength="@SlugGenerator.AppNameMaxLength"
                       data-app-name-max-length="@SlugGenerator.AppNameMaxLength"
                       autocomplete="off"
                       data-repo-preview-target="repository-name-preview"
                       data-repo-org-target="repository-url-preview" />
            </div>

            <div class="govuk-inset-text" id="repository-preview">
                <p class="govuk-body govuk-!-margin-bottom-1">Repo URL will be:</p>
                <p class="govuk-body govuk-!-margin-bottom-2">
                    <code id="repository-url-preview">@(string.IsNullOrWhiteSpace(repositoryUrlPreview) ? "https://github.com/DFE-Digital/" + Model.RepositoryNamePreview : repositoryUrlPreview)</code>
                </p>
                <p class="govuk-body-s govuk-!-margin-bottom-0" id="repository-name-preview-note">
                    <span class="govuk-visually-hidden" id="repository-name-preview">@Model.RepositoryNamePreview</span>
                    <code>xxxx</code> is replaced with a random string.
                </p>
            </div>

            @if (Model.CompassConfigured)
            {
                <div class="govuk-form-group">
                    <label class="govuk-label" asp-for="Input.CompassWorkItemId"></label>
                    <span class="govuk-hint">
                        Optional. Link this prototype to an active
                        <a class="govuk-link" href="https://compass.education.gov.uk/modern/work/all" target="_blank" rel="noopener noreferrer">COMPASS work</a>
                        item. If unsure, leave empty.
                    </span>
                    <span class="govuk-error-message" asp-validation-for="Input.CompassWorkItemId"></span>
                    <select class="govuk-select create-form__select"
                            asp-for="Input.CompassWorkItemId"
                            asp-items="@(new SelectList(Model.CompassWorkItems, nameof(CompassWorkItemOption.Id), nameof(CompassWorkItemOption.Title), Model.Input.CompassWorkItemId))">
                        <option value="">Not linked</option>
                    </select>
                </div>

                <div class="govuk-form-group">
                    <label class="govuk-label" asp-for="Input.CompassProductId"></label>
                    <span class="govuk-hint">
                        Optional. Link this prototype to a
                        <a class="govuk-link" href="https://compass.education.gov.uk/modern/manage/fips/products?tab=active" target="_blank" rel="noopener noreferrer">COMPASS product</a>
                        (enterprise services excluded). Business areas are shown next to the product name.
                    </span>
                    <span class="govuk-error-message" asp-validation-for="Input.CompassProductId"></span>
                    <select class="govuk-select create-form__select"
                            asp-for="Input.CompassProductId"
                            asp-items="@(new SelectList(Model.CompassProducts, nameof(CompassProductOption.Id), nameof(CompassProductOption.DisplayName), Model.Input.CompassProductId))">
                        <option value="">Not linked</option>
                    </select>
                </div>
            }
            else
            {
                <div class="govuk-inset-text">
                    COMPASS linking is unavailable until <code>CompassApi:BaseUrl</code> and <code>CompassApi:ApiToken</code> are configured.
                </div>
            }

            <div class="govuk-form-group">
                <label class="govuk-label" asp-for="Input.PrototypePassword"></label>
                <div class="govuk-hint">
                    All prototypes must be password protected. You'll be able to update this once your app is created. @PrototypePasswordRules.MinimumLength characters minimum.
                </div>
                <span class="govuk-error-message" asp-validation-for="Input.PrototypePassword"></span>
                <input class="govuk-input govuk-input--width-20"
                       asp-for="Input.PrototypePassword"
                       id="prototype-password"
                       type="text"
                       autocomplete="new-password"
                       spellcheck="false" />
            </div>

            @if (Model.AvailableBusinessAreas.Any())
            {
                <div class="govuk-form-group">
                    <label class="govuk-label" asp-for="Input.BusinessAreaId">Business area</label>
                    <span class="govuk-hint">Select the business area responsible for this prototype.</span>
                    <span class="govuk-error-message" asp-validation-for="Input.BusinessAreaId"></span>
                    <select class="govuk-select create-form__select"
                            asp-for="Input.BusinessAreaId"
                            asp-items="@(new SelectList(Model.AvailableBusinessAreas, nameof(BusinessArea.Id), nameof(BusinessArea.Name), Model.Input.BusinessAreaId))">
                        @if (Model.AvailableBusinessAreas.Count > 1)
                        {
                            <option value="">Select a business area</option>
                        }
                    </select>
                </div>
            }

            <div class="govuk-form-group">
                <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input" asp-for="Input.DeclarationAgreed" />
                        <label class="govuk-label govuk-checkboxes__label" asp-for="Input.DeclarationAgreed"></label>
                    </div>
                </div>
                <span class="govuk-error-message" asp-validation-for="Input.DeclarationAgreed"></span>
            </div>

            <govuk-button>Create prototype</govuk-button>
        </form>
    </div>
</div>

<script>
(() => {
  const appNameInput = document.getElementById('prototype-app-name');
  const urlPreview = document.getElementById('repository-url-preview');
  const orgSelect = document.getElementById('Input_GitHubOrganisation');
  const orgHidden = document.querySelector('input[name="Input.GitHubOrganisation"][type="hidden"]');
  if (!appNameInput || !urlPreview) {
    return;
  }

  const maxLength = Number(appNameInput.getAttribute('data-app-name-max-length') || '25');

  // While typing, keep a trailing hyphen so spaces/hyphens are not wiped mid-word.
  const normalise = (value, { allowTrailingHyphen = false } = {}) => {
    let result = '';
    let previousHyphen = false;

    for (const character of value.replace(/^\s+/, '')) {
      let next = '';
      if (/\s|[_.]/.test(character)) {
        next = '-';
      } else if (/[A-Za-z0-9-]/.test(character)) {
        next = character.toLowerCase();
      } else {
        continue;
      }

      if (next === '-') {
        if (!result || previousHyphen) {
          continue;
        }
        previousHyphen = true;
        result += '-';
        continue;
      }

      if (!result && /[0-9]/.test(next)) {
        continue;
      }

      previousHyphen = false;
      result += next;
    }

    result = result.replace(/^-+/g, '').slice(0, maxLength);

    if (!allowTrailingHyphen) {
      result = result.replace(/-+$/g, '');
    }

    return result;
  };

  const selectedOrganisation = () => {
    if (orgSelect && orgSelect.value) {
      return orgSelect.value;
    }
    if (orgHidden && orgHidden.value) {
      return orgHidden.value;
    }
    return 'DFE-Digital';
  };

  const applyValue = (normalised) => {
    if (appNameInput.value !== normalised) {
      const start = appNameInput.selectionStart;
      appNameInput.value = normalised;
      if (typeof start === 'number') {
        appNameInput.setSelectionRange(Math.min(start, normalised.length), Math.min(start, normalised.length));
      }
    }

    const previewName = normalised.replace(/-+$/g, '');
    const repoName = previewName
      ? ('prototype-xxxx-' + previewName)
      : 'prototype-xxxx-';
    urlPreview.textContent = 'https://github.com/' + selectedOrganisation() + '/' + repoName;
  };

  const updateWhileTyping = () => {
    applyValue(normalise(appNameInput.value, { allowTrailingHyphen: true }));
  };

  const finalise = () => {
    applyValue(normalise(appNameInput.value, { allowTrailingHyphen: false }));
  };

  appNameInput.addEventListener('input', updateWhileTyping);
  appNameInput.addEventListener('blur', finalise);
  appNameInput.form?.addEventListener('submit', finalise);
  if (orgSelect) {
    orgSelect.addEventListener('change', updateWhileTyping);
  }
  updateWhileTyping();
})();
</script>
