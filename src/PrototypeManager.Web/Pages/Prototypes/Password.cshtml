@page
@model PrototypeManager.Web.Pages.Prototypes.PasswordModel
@{
    ViewData["Title"] = "Change prototype password";
}

@if (Model.Prototype is null)
{
    <p class="govuk-body">Prototype not found.</p>
    return;
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">@Model.Prototype.Name</span>
        <h1 class="govuk-heading-l">Change prototype password</h1>
        <p class="govuk-body">This updates the password on the hosted prototype. The new password is not shown again after you save.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body" asp-validation-summary="All"></div>
                </div>
            </div>
        }

        <form method="post" asp-route-id="@Model.Prototype.Id" class="processing-trigger">
            <govuk-password-input for="NewPassword"
                                  id="newPassword"
                                  autocomplete="new-password"
                                  input-class="govuk-input--width-20">
                <govuk-password-input-label>New prototype password</govuk-password-input-label>
                <govuk-password-input-hint>Use at least @PrototypePasswordRules.MinimumLength characters.</govuk-password-input-hint>
            </govuk-password-input>

            <govuk-button>Save changes</govuk-button>
            <a class="govuk-link govuk-!-margin-left-3" href="@Url.Page("/Prototypes/Details", new { id = Model.Prototype.Id, section = DetailsModel.PrototypeSection })">Cancel</a>
        </form>
    </div>
</div>
