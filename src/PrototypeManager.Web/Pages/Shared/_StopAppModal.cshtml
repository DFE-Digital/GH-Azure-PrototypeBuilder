@model PrototypeManager.Web.Pages.Prototypes.DetailsModel

<dialog id="stop-app-modal"
        class="dfe-f-modal govuk-!-margin-0"
        data-module="dfe-f-modal"
        aria-labelledby="stop-app-modal-title"
        aria-describedby="stop-app-modal-description">
    <div class="dfe-f-modal__panel">
        <form method="post" asp-page-handler="StopApp" asp-route-id="@Model.Prototype!.Id">
            <header class="dfe-f-modal__header">
                <h2 class="govuk-heading-m dfe-f-modal__title" id="stop-app-modal-title">Stop app</h2>
                <button type="button" class="dfe-f-modal__close" data-dfe-modal-close aria-label="Close">
                    <span class="dfe-f-modal__close-x" aria-hidden="true">×</span>
                </button>
            </header>
            <div class="dfe-f-modal__body" id="stop-app-modal-description">
                <p class="govuk-body">
                    This will stop the hosted app for <strong>@Model.Prototype!.Name</strong>.
                    Anyone visiting the prototype URL will not be able to use the app until it is started again.
                </p>
            </div>
            <footer class="dfe-f-modal__footer">
                <button type="submit" class="govuk-button govuk-button--warning">Stop app</button>
                <button type="button" class="govuk-button govuk-button--secondary" data-dfe-modal-close>Cancel</button>
            </footer>
        </form>
    </div>
</dialog>
