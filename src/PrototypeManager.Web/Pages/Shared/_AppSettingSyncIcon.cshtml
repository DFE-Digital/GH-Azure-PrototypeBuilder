@using PrototypeManager.Application
@model string
@{
    var status = Model ?? AppSettingSyncStatuses.Synced;
    var isSynced = string.Equals(status, AppSettingSyncStatuses.Synced, StringComparison.Ordinal);
    var label = status switch
    {
        AppSettingSyncStatuses.Pending => "Waiting to sync with Azure",
        AppSettingSyncStatuses.Syncing => "Syncing with Azure",
        AppSettingSyncStatuses.Failed => "Azure sync failed",
        AppSettingSyncStatuses.Synced => "Synced with Azure",
        _ => "Synced with Azure"
    };
}

<span class="app-setting-sync"
      data-sync-status="@status"
      hidden="@isSynced"
      title="@label"
      aria-label="@label">
    <svg class="app-setting-sync__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path class="app-setting-sync__arrows"
              d="M7.5 4.5v3.2A6.5 6.5 0 0 0 5.4 15a6.5 6.5 0 0 0 9.8 4.4l-.9-1.2A5 5 0 0 1 6.9 15a5 5 0 0 1 1.9-3.9V14l3.5-3.7L7.5 6.7V4.5zm9 15v-3.2A6.5 6.5 0 0 0 18.6 9a6.5 6.5 0 0 0-9.8-4.4l.9 1.2A5 5 0 0 1 17.1 9a5 5 0 0 1-1.9 3.9V10l-3.5 3.7 3.8 3.6V19.5z" />
        <path class="app-setting-sync__check"
              d="M9.2 12.7 7.8 11.3l-1.4 1.4 2.8 2.8 5.7-5.7-1.4-1.4z" />
        <path class="app-setting-sync__cross"
              d="M8.2 8.2 7 9.4 9.6 12 7 14.6l1.2 1.2L10.8 13.2l2.6 2.6 1.2-1.2L12 12l2.6-2.6-1.2-1.2L10.8 10.8 8.2 8.2z" />
    </svg>
    <span class="app-setting-sync__label govuk-visually-hidden">@label</span>
</span>
