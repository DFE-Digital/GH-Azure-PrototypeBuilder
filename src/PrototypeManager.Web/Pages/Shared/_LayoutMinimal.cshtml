@{
    Layout = "_GovUkPageTemplate";
    ViewData["Title"] ??= "Prototype Manager";
}

@section Head {
    @Html.GovUkFrontendStyleImports()
    <link rel="stylesheet" href="~/_content/DfEDigital.Frontend.AspNetCore/dfe/dfe.min.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}

@section GovUkHeader {
    <header class="govuk-header dfe-f-header" role="banner" data-module="govuk-header">
        <div class="govuk-header__container govuk-width-container">
            <div class="govuk-header__logo">
                <a href="https://www.gov.uk/government/organisations/department-for-education"
                   class="govuk-header__homepage-link govuk-header__link govuk-header__link--homepage">
                    <img src="~/_content/DfEDigital.Frontend.AspNetCore/dfe/dfe-logo-white.png"
                         asp-append-version="true"
                         alt="Department for Education"
                         class="govuk-header__logotype dfe-f-header__logo-img dfe-f-header__logo-img--white"
                         decoding="async" />
                    <img src="~/_content/DfEDigital.Frontend.AspNetCore/dfe/dfe-logo-black.png"
                         asp-append-version="true"
                         alt=""
                         class="govuk-header__logotype dfe-f-header__logo-img dfe-f-header__logo-img--black"
                         decoding="async"
                         aria-hidden="true" />
                </a>
            </div>
        </div>
    </header>
}

@section BeforeContent {
    @await RenderSectionAsync("BeforeContent", required: false)
}

@RenderBody()

@section BodyEnd {
    <script defer src="~/_content/DfEDigital.Frontend.AspNetCore/dfe/dfe-frontend.iife.min.js" asp-append-version="true"></script>
    <script>
        window.addEventListener("DOMContentLoaded", function () {
            if (window.DfeFrontend?.initAll) {
                window.DfeFrontend.initAll();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
}
