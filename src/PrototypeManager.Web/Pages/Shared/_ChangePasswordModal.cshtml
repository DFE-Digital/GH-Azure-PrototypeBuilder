@model PrototypeManager.Web.Pages.Prototypes.DetailsModel

<dialog id="change-password-modal"
        class="dfe-f-modal govuk-!-margin-0"
        data-module="dfe-f-modal"
        data-password-url="@Model.PasswordFetchUrl"
        aria-labelledby="change-password-modal-title"
        aria-describedby="change-password-modal-description">
    <div class="dfe-f-modal__panel">
        <form method="post" asp-page-handler="ChangePassword" asp-route-id="@Model.Prototype!.Id">
            <header class="dfe-f-modal__header">
                <h2 class="govuk-heading-m dfe-f-modal__title" id="change-password-modal-title">Manage prototype password</h2>
                <button type="button" class="dfe-f-modal__close" data-dfe-modal-close aria-label="Close">
                    <span class="dfe-f-modal__close-x" aria-hidden="true">×</span>
                </button>
            </header>
            <div class="dfe-f-modal__body" id="change-password-modal-description">
                <govuk-password-input id="change-password-current-value"
                                      name="current-password-display"
                                      value="Loading…"
                                      readonly="true"
                                      autocomplete="off"
                                      show-password-aria-label-text="Show current password"
                                      hide-password-aria-label-text="Hide current password"
                                      input-class="govuk-input--width-20"
                                      class="govuk-!-margin-bottom-4">
                    <govuk-password-input-label>Current password</govuk-password-input-label>
                </govuk-password-input>
                <govuk-password-input name="NewPassword"
                                      id="newPassword"
                                      autocomplete="new-password"
                                      show-password-aria-label-text="Show new password"
                                      hide-password-aria-label-text="Hide new password"
                                      input-class="govuk-input--width-20"
                                      input-minlength="@PrototypePasswordRules.MinimumLength"
                                      input-required="true">
                    <govuk-password-input-label>New password</govuk-password-input-label>
                    <govuk-password-input-hint>Must be at least @PrototypePasswordRules.MinimumLength characters.</govuk-password-input-hint>
                </govuk-password-input>
            </div>
            <footer class="dfe-f-modal__footer">
                <button type="submit" class="govuk-button">Save password</button>
                <button type="button" class="govuk-button govuk-button--secondary" data-dfe-modal-close>Cancel</button>
            </footer>
        </form>
    </div>
</dialog>
