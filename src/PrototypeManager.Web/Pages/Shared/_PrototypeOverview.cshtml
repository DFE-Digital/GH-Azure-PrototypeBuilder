@using PrototypeManager.Web.Pages.Prototypes
@model PrototypeManager.Web.Pages.Prototypes.DetailsModel

<div class="dfe-c-fe-dashboard">
    <div class="dfe-c-fe-dashboard__metrics">
        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Hosting status</h2>
            <p class="dfe-c-fe-metric__value">
                <span class="@Model.HostingHealth.BadgeClass">
                    @Model.HostingHealth.Label
                </span>
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.HostingHealth.Detail))
            {
                <p class="dfe-c-fe-text govuk-!-margin-bottom-0 govuk-!-margin-top-2">@Model.HostingHealth.Detail</p>
            }
        </section>

        @if (Model.Prototype.Status == PrototypeStatus.Live && !string.IsNullOrWhiteSpace(Model.Prototype.AzureWebAppName))
        {
            <section class="dfe-c-fe-panel dfe-c-fe-metric">
                <h2 class="dfe-c-fe-metric__label">App status</h2>
                <p class="dfe-c-fe-metric__value">
                    <span class="@DetailsModel.GetRuntimeBadgeClass(Model.WebAppRuntime.PowerState)">
                        @Model.WebAppRuntime.Label
                    </span>
                </p>
                @if (Model.CanManage && Model.WebAppRuntime.CanStop)
                {
                    <p class="dfe-c-fe-metric__action govuk-!-margin-bottom-0">
                        <a class="govuk-link"
                           href="#"
                           role="button"
                           aria-controls="stop-app-modal">
                            Stop app
                        </a>
                    </p>
                }
                else if (Model.CanManage && Model.WebAppRuntime.CanStart)
                {
                    <p class="dfe-c-fe-metric__action govuk-!-margin-bottom-0">
                        <a class="govuk-link"
                           href="#"
                           role="button"
                           aria-controls="start-app-modal">
                            Start app
                        </a>
                    </p>
                }
            </section>
        }

        <section class="dfe-c-fe-panel dfe-c-fe-metric">
            <h2 class="dfe-c-fe-metric__label">Stack</h2>
            <p class="dfe-c-fe-metric__value">@DetailsModel.FormatStackSummary(Model.Prototype)</p>
            @if (Model.OpenHigherPlanRequest is { } openRequest)
            {
                <p class="dfe-c-fe-metric__action govuk-!-margin-bottom-0">
                    <span class="dfe-c-fe-badge dfe-c-fe-badge--info">
                        Higher plan @openRequest.RequestedSku requested
                    </span>
                </p>
            }
            else if (Model.CanRequestHigherPlan)
            {
                <p class="dfe-c-fe-metric__action govuk-!-margin-bottom-0">
                    <a class="govuk-link"
                       href="#"
                       role="button"
                       aria-controls="request-higher-plan-modal">
                        Request higher plan
                    </a>
                </p>
            }
        </section>
    </div>

    <section class="dfe-c-fe-panel">
        <div class="dfe-c-fe-panel__header dfe-c-fe-panel__header--split">
            <div>
                <h2 class="dfe-c-fe-heading">Deployment history</h2>
                <p class="dfe-c-fe-text">Recent provisioning and deployment jobs for this prototype.</p>
            </div>
            <a class="dfe-c-fe-link" href="@Model.SectionUrl(DetailsModel.HistorySection)">View all activity</a>
        </div>

        @if (!Model.RecentJobs.Any())
        {
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0">No deployment jobs have been recorded yet.</p>
        }
        else
        {
            <table class="govuk-table dfe-c-fe-dashboard-table govuk-!-margin-bottom-0">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">Job</th>
                        <th scope="col" class="govuk-table__header">Status</th>
                        <th scope="col" class="govuk-table__header">Completed</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                @foreach (var job in Model.RecentJobs)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@DetailsModel.GetJobTypeLabel(job.Type)</td>
                        <td class="govuk-table__cell">
                            <span class="@DetailsModel.GetJobStatusClass(job.Status)">@job.Status</span>
                        </td>
                        <td class="govuk-table__cell">@(job.CompletedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section class="dfe-c-fe-panel">
        <div class="dfe-c-fe-panel__header">
            <div>
                <h2 class="dfe-c-fe-heading">App details</h2>
                <p class="dfe-c-fe-text">Core information for this hosting environment.</p>
            </div>
        </div>

        <dl class="govuk-summary-list govuk-!-margin-bottom-0">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Prototype app name</dt>
                <dd class="govuk-summary-list__value">@Model.Prototype.Name</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Project</dt>
                <dd class="govuk-summary-list__value">@Model.Prototype.ServiceName</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Business area</dt>
                <dd class="govuk-summary-list__value">@Model.Prototype.BusinessArea?.Name</dd>
                @if (Model.CanManage && Model.AvailableBusinessAreas.Any())
                {
                    <dd class="govuk-summary-list__actions">
                        <a class="govuk-link"
                           href="#"
                           role="button"
                           aria-controls="change-business-area-modal">
                            Change<span class="govuk-visually-hidden"> business area</span>
                        </a>
                    </dd>
                }
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">COMPASS work item</dt>
                <dd class="govuk-summary-list__value">
                    @if (Model.Prototype.CompassWorkItemId is int workItemId)
                    {
                        <a class="govuk-link"
                           href="https://compass.education.gov.uk"
                           target="_blank"
                           rel="noopener noreferrer">
                            @(string.IsNullOrWhiteSpace(Model.Prototype.CompassWorkItemTitle)
                                ? $"Work item {workItemId}"
                                : Model.Prototype.CompassWorkItemTitle)
                        </a>
                    }
                    else
                    {
                        <span>Not linked</span>
                    }
                </dd>
                @if (Model.CanAssignCompass)
                {
                    <dd class="govuk-summary-list__actions">
                        <a class="govuk-link"
                           href="#"
                           role="button"
                           aria-controls="change-compass-work-item-modal">
                            @(Model.Prototype.CompassWorkItemId is null ? "Assign" : "Change")<span class="govuk-visually-hidden"> COMPASS work item</span>
                        </a>
                    </dd>
                }
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">COMPASS product</dt>
                <dd class="govuk-summary-list__value">
                    @if (!string.IsNullOrWhiteSpace(Model.Prototype.CompassProductId))
                    {
                        <a class="govuk-link"
                           href="https://compass.education.gov.uk"
                           target="_blank"
                           rel="noopener noreferrer">
                            @(string.IsNullOrWhiteSpace(Model.Prototype.CompassProductName)
                                ? Model.Prototype.CompassProductId
                                : Model.Prototype.CompassProductName)
                        </a>
                    }
                    else
                    {
                        <span>Not linked</span>
                    }
                </dd>
                @if (Model.CanAssignCompass)
                {
                    <dd class="govuk-summary-list__actions">
                        <a class="govuk-link"
                           href="#"
                           role="button"
                           aria-controls="change-compass-product-modal">
                            @(string.IsNullOrWhiteSpace(Model.Prototype.CompassProductId) ? "Assign" : "Change")<span class="govuk-visually-hidden"> COMPASS product</span>
                        </a>
                    </dd>
                }
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Owner</dt>
                <dd class="govuk-summary-list__value">@Model.Prototype.OwnerEmail</dd>
                @if (Model.CanManageContacts)
                {
                    <dd class="govuk-summary-list__actions">
                        <a class="govuk-link" href="@Model.SectionUrl(DetailsModel.ContactsSection)">
                            Manage<span class="govuk-visually-hidden"> contacts</span>
                        </a>
                    </dd>
                }
            </div>
        </dl>
    </section>

    <section class="dfe-c-fe-panel">
        <div class="dfe-c-fe-panel__header">
            <div>
                <h2 class="dfe-c-fe-heading">GitHub repository</h2>
                <p class="dfe-c-fe-text">Open the repo in GitHub or clone it locally.</p>
            </div>
        </div>

        @if (!Model.HasGitHubRepository)
        {
            <p class="dfe-c-fe-text govuk-!-margin-bottom-0">The GitHub repository has not been set up yet.</p>
        }
        else
        {
            <div class="dfe-c-fe-repo">
                <div class="dfe-c-fe-repo__primary">
                    <p class="dfe-c-fe-repo__label">Repository</p>
                    <a class="dfe-c-fe-repo__name govuk-link"
                       href="@Model.GitHubRepositoryNormalizedUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        @Model.GitHubRepositoryDisplayName
                    </a>
                    <p class="dfe-c-fe-repo__url">
                        <span class="govuk-visually-hidden">Full repository URL</span>
                        @Model.GitHubRepositoryNormalizedUrl
                    </p>
                </div>

                <div class="dfe-c-fe-repo__clone">
                    <p class="dfe-c-fe-repo__label">Clone with Git</p>
                    @if (!string.IsNullOrWhiteSpace(Model.GitHubCloneHttpsCommand))
                    {
                        <div class="dfe-c-fe-code-row">
                            <div class="dfe-c-fe-code-row__meta">
                                <span class="dfe-c-fe-code-row__protocol">HTTPS</span>
                            </div>
                            <code class="dfe-c-fe-code-row__command">@Model.GitHubCloneHttpsCommand</code>
                            <button type="button"
                                    class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 dfe-c-fe-code-row__copy"
                                    data-copy-text="@Model.GitHubCloneHttpsCommand">
                                Copy
                            </button>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.GitHubCloneSshCommand))
                    {
                        <div class="dfe-c-fe-code-row">
                            <div class="dfe-c-fe-code-row__meta">
                                <span class="dfe-c-fe-code-row__protocol">SSH</span>
                            </div>
                            <code class="dfe-c-fe-code-row__command">@Model.GitHubCloneSshCommand</code>
                            <button type="button"
                                    class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 dfe-c-fe-code-row__copy"
                                    data-copy-text="@Model.GitHubCloneSshCommand">
                                Copy
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </section>
</div>
